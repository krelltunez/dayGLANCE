    <string name="health_permissions_title">Health Connect Permissions</string>
    <string name="health_intro">dayGLANCE uses Health Connect to display your daily progress as habit rings on the main day view.</string>
    <string name="health_steps">Steps</string>
    <string name="health_steps_desc">Reads your daily step count to fill the steps habit ring, showing progress toward a daily step goal you set yourself.</string>
    <string name="health_sleep">Sleep</string>
    <string name="health_sleep_desc">Reads your most recent sleep session duration to fill the sleep habit ring, showing progress toward a daily sleep duration goal you set yourself.</string>
    <string name="health_data_handling">How your data is handled</string>
    <string name="health_local_only">• Health data is read on-device and rendered locally in the app.</string>
    <string name="health_no_analytics">• It is never used for analytics, shared with third parties, or written back to Health Connect.</string>
    <string name="health_no_servers">• dayGLANCE has no developer-operated servers, no account system, and no telemetry.</string>
    <string name="health_cloud_sync">• If you have enabled optional Cloud Sync, habit data is included in the sync payload using zero-knowledge AES-256-GCM encryption. The destination server (which you control) sees only encrypted ciphertext.</string>
    <string name="health_optional">Granting Health Connect permissions is entirely optional. dayGLANCE functions normally without them. You can revoke these permissions at any time through the Health Connect app or your device\'s system settings.</string>
    <string name="health_privacy_policy">Read the full privacy policy →</string>
