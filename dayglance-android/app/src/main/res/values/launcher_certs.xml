<?xml version="1.0" encoding="utf-8"?>
<!--
  The signers com.dayglance.permission.LAUNCHER trusts (AndroidManifest.xml,
  docs/launcher-integration.md): SHA-256 digests of the GLANCElauncher's
  signing certificates, lowercase hex, no colons. These are the LAUNCHER's
  certificates, not dayGLANCE's.

  To read one:  keytool -list -v -keystore <keystore> -alias <alias> | grep SHA256
  then strip the colons and lowercase.

  One entry covers every launcher build: the launcher's upload key was given to
  Play App Signing, so the Play build is signed with the release key too (its
  App signing key certificate in Play Console matches this digest). There is no
  debug entry: where the release key is present, debug builds carry it too. If
  the launcher is ever signed with another key, add that digest here.
-->
<resources>
    <string-array name="launcher_known_certs">
        <!-- GLANCElauncher release certificate (GitHub releases and Google Play) -->
        <item>7e6d39d03c5d4c4f4c947c4d7f9657e9ae6ab94d296c97d684333450c2b7791d</item>
    </string-array>
</resources>
