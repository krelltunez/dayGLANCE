{
  "name": "dayglance-bridge",
  "version": "1.0.1",
  "description": "dayGLANCE Bridge, the Obsidian plugin that connects a vault to dayGLANCE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:stamped": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production --stamp",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.30.1",
    "@eslint/json": "0.14.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "@glance-apps/agenda-core": "file:../packages/agenda-core",
    "@glance-apps/obsidian-format": "file:../packages/obsidian-format",
    "@glance-apps/sync": "2.4.0"
  }
}
